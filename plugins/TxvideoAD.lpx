#!name = 腾讯视频净化
#!author = TG@ZenMoFiShi
#!update = 2026-11-03
#!desc = 去除开屏广告、视频播放前广告、底部的多余 tap 栏、我的页面美化、我的界面顶部广告

[Rule]
DOMAIN,iacc.stgw.qq.com,REJECT
DOMAIN,tacc.video.qq.com,REJECT

[Script]
http-request ^https?:\/\/i\.video\.qq\.com\/(?:\?.*)?$ script-path=https://raw.githubusercontent.com/TTTi222/Loon-Plugins/main/scripts/Txvideoad-ab07c07cd2f6207fd3c0.js,requires-body=true,binary-body-mode=true,timeout=15,tag=Txvideo-request-i.video.qq.com
http-response ^https?:\/\/i\.video\.qq\.com\/(?:\?.*)?$ script-path=https://raw.githubusercontent.com/TTTi222/Loon-Plugins/main/scripts/Txvideoad-ab07c07cd2f6207fd3c0.js,requires-body=true,binary-body-mode=true,timeout=15,tag=Txvideo-response-i.video.qq.com
http-response ^https?:\/\/iacc\.qq\.com\/(?:\?.*)?$ script-path=https://raw.githubusercontent.com/TTTi222/Loon-Plugins/main/scripts/Txvideoad-ab07c07cd2f6207fd3c0.js,requires-body=true,binary-body-mode=true,timeout=15,tag=Txvideo-response-iacc.qq.com
http-response ^https?:\/\/config\.ab\.qq\.com\/tab\/GetTabRemoteConfig(?:\?.*)?$ script-path=https://raw.githubusercontent.com/TTTi222/Loon-Plugins/main/scripts/Txvideoad-ab07c07cd2f6207fd3c0.js,requires-body=true,binary-body-mode=true,timeout=15,tag=Txvideo-response-config.ab.qq.com
http-response ^https:\/\/rdelivery\.qq\.com\/v1\/sdkconfig\/get(?:\?.*)?$ script-path=https://raw.githubusercontent.com/TTTi222/Loon-Plugins/main/scripts/Txvideoad-ab07c07cd2f6207fd3c0.js,requires-body=true,binary-body-mode=false,timeout=15,tag=Txvideo-response-rdelivery.qq.com

[MITM]
hostname = i.video.qq.com, iacc.qq.com, config.ab.qq.com, rdelivery.qq.com
