#!desc = 净化弹窗、首页推荐流、借钱入口与会员领券横条，隐藏我的页推广宫格、推荐、奖励金、接单券提醒及钱包金融整排，去除车主接单列表会员推广卡片。
# Loon: safe pass-through when request context is unavailable.

[Rewrite]
^https?:\/\/api-htp\.beizi\.biz\/mb\/sdk0\/json(?:\?|$) reject-200
^https?:\/\/adservice\.sigmob\.cn\/(?:hb\/v2\/ad|ad\/v4)(?:\?|$) reject-200
^https?:\/\/tm\.sigmob\.cn\/(?:waterfall\/v1|strategy\/v6)(?:\?|$) reject-200
^https?:\/\/(?:mi|v2mi)\.gdt\.qq\.com\/(?:gdt_mview\.fcg|server_bidding2)(?:\?|$) reject-200

[Script]
http-request ^https:\/\/resource\.51downapp\.cn\/f414fbc17c411b4e986ba8891c738a49\.json\?(?:[^#]*&)?md5=e5230c919f7e3f3af3256161fbfaa0e2&(?:[^#]*&)?hbe_qx_ui=1\.3$ script-path=https://raw.githubusercontent.com/TTTi222/Loon-Plugins/main/scripts/easybike-ad-23b1b2849eede1094807.js,requires-body=false,binary-body-mode=false,timeout=20,tag=HelloBike-1
http-response ^https:\/\/api\.hellobike\.com(?::443)?\/secretkey(?:\?|$) script-path=https://raw.githubusercontent.com/TTTi222/Loon-Plugins/main/scripts/easybike-ad-23b1b2849eede1094807.js,requires-body=true,binary-body-mode=false,timeout=20,tag=HelloBike-2
http-request ^https?:\/\/(?:api|marketingapi|entertainment)\.hellobike\.com(?::\d+)?\/api(?:\?|$) script-path=https://raw.githubusercontent.com/TTTi222/Loon-Plugins/main/scripts/easybike-ad-23b1b2849eede1094807.js,requires-body=true,binary-body-mode=false,timeout=20,tag=HelloBike-3
http-response ^https?:\/\/(?:api|marketingapi|entertainment)\.hellobike\.com(?::\d+)?\/api(?:\?|$) script-path=https://raw.githubusercontent.com/TTTi222/Loon-Plugins/main/scripts/easybike-ad-23b1b2849eede1094807.js,requires-body=true,binary-body-mode=false,timeout=20,tag=HelloBike-4
http-response ^https:\/\/taxiapi\.hellobike\.com(?::443)?\/api(?:\?|$) script-path=https://raw.githubusercontent.com/TTTi222/Loon-Plugins/main/scripts/easybike-ad-23b1b2849eede1094807.js,requires-body=true,binary-body-mode=false,timeout=20,tag=HelloBike-5

