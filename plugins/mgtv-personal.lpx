#!name = 芒果 TV 个人凭据配置
#!desc = 仅用于本人获准使用的播放凭据；默认关闭，不内置或同步任何 Ticket。
#!author = TTTi222（Loon 适配）
#!homepage = https://github.com/TTTi222/Loon-Plugins

[Argument]
enabled = switch,false,tag=启用个人凭据
ticket = input,"",tag=个人 Ticket,desc=仅填写本人获准使用的凭据；勿分享配置

[Script]
request if ${url} ~= /^https:\/\/mobile-stream\.api\.mgtv\.com\/v1\/video\/source(?:\?|$)/ then script("https://raw.githubusercontent.com/TTTi222/Loon-Plugins/main/scripts/mgtv-personal.js", {${ticket}}) with enable=${enabled}, tag="个人播放凭据", requires_body=false, debug=false

[MITM]
hostname = mobile-stream.api.mgtv.com
